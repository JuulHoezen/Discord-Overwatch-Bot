{
  "name": "overwatch-discord-bot",
  "private": true,
  "version": "1.0.0",
  "description": "Discord-bot met Overwatch-seizoenen, events, heroes, maps en spelersprofielen",
  "main": "bot/index.js",
  "type": "module",
  "engines": {
    "node": ">=18.x"
  },
  "scripts": {
    "bot": "node bot/index.js",
    "bot:dev": "nodemon bot/index.js",
    "deploy": "node bot/deploy-commands.js",
    "sync": "node bot/sync.js",
    "smoke": "node bot/test/smoke.js",
    "whereami": "node bot/lib/inspect.js",
    "smoke:worker": "node worker/test/local.js",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "verify": "npm run smoke && npm run smoke:worker"
  },
  "author": "1KEY ICT Solutions",
  "license": "MIT",
  "dependencies": {
    "discord.js": "^14.27.0",
    "dotenv": "^16.0.3"
  },
  "devDependencies": {
    "nodemon": "^3.0.0",
    "wrangler": "^4.151.2"
  }
}
