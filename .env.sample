# Kopieer dit bestand naar .env en vul de waarden in.
# .env staat in .gitignore; commit dus nooit het bestand met echte waarden.
#
# APP_ID en DISCORD_TOKEN vind je in het Discord Developer Portal
# (Applications > jouw app > General Information / Bot > Reset Token).
APP_ID=<YOUR_APP_ID>
DISCORD_TOKEN=<YOUR_BOT_TOKEN>

# Alleen nodig voor de Cloudflare Worker (worker/README.md): daar zet je hem als
# secret, niet in dit bestand. De Gateway-versie gebruikt hem niet.
PUBLIC_KEY=<YOUR_PUBLIC_KEY>

# --- Gateway-versie (npm run bot) ---
# Guild-ID waar de slash commands direct zichtbaar zijn. Leeg = globaal (kan tot 1 uur duren).
DISCORD_GUILD_ID=
# Kanaal-ID waar de bot dagelijks de seizoenscountdown plaatst. Leeg = die functie staat uit.
TRACKER_CHANNEL_ID=
# Uur van de dag (lokale tijd, 0-23) waarop die countdown ververst.
TRACKER_UUR=9
